# ── Insurimax Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values.

# App
ENVIRONMENT=development
DEBUG=true
# JWT signing key (required, at least 32 random bytes). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The API refuses to start if it is empty, a published placeholder, or too short.
SECRET_KEY=

# ── Database (Cloud SQL / AlloyDB) ────────────────────────────────────────────
# Option A: individual components
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Insurimax
DB_USER=postgres
DB_PASSWORD=yourpassword

# Option B: override with full URL (takes precedence over A)
# DATABASE_URL=postgresql://user:pass@/dbname?host=/cloudsql/project:region:instance

# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# For local dev: path to service account key JSON
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# For local dev without Vertex AI: use google-generativeai with API key
GOOGLE_API_KEY=your-gemini-api-key
VERTEX_AI_ENABLED=false

# For production on GCP (Cloud Run): set to true and use ADC
# VERTEX_AI_ENABLED=true

# ── GCS ───────────────────────────────────────────────────────────────────────
GCS_BUCKET_NAME=Insurimax-documents
GCS_SIGNED_URL_EXPIRY_MINUTES=30

# ── Gemini Models ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-1.5-pro-002
GEMINI_FLASH_MODEL=gemini-1.5-flash-002

# ── SLA ───────────────────────────────────────────────────────────────────────
SLA_HOURS=3
SLA_WARNING_MINUTES=30

# ── Auto-approval ─────────────────────────────────────────────────────────────
AUTO_APPROVAL_CONFIDENCE_THRESHOLD=0.92
AUTO_APPROVAL_MAX_AMOUNT_INR=50000.0

# ── CORS (comma-separated origins) ───────────────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","https://your-frontend.web.app"]
